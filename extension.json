{
  "apiVersion": 1,
  "id": "at365.watch",
  "name": "Applet.Watch.at365",
  "displayName": "Watch.at365",
  "version": "0.3.0",
  "minimumHostVersion": "0.15.0",
  "updateRepository": "5ynonym/Applet.Watch.at365",
  "runtime": "dotnet",
  "entry": "Applet.Watch.at365.dll",
  "description": "時計と日付のウィジェットをホームと透過デスクトップに提供します。",
  "capabilities": ["ui", "settings", "widgets"],
  "settings": [
    {
      "key": "showSeconds",
      "title": "秒を表示",
      "type": "boolean",
      "default": true,
      "description": "時・分の隣に秒を表示します。"
    },
    {
      "key": "letterSpacing",
      "title": "文字間隔（px）",
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 100,
      "step": 1,
      "description": "時計と日付の文字間を広げます。"
    }
  ],
  "type": "Applets.Watch.ClockApplet",
  "widgets": [
    {
      "content": {
        "showSeconds": true,
        "locale": "en-GB",
        "kind": "clock"
      },
      "title": "時計",
      "id": "at365.watch.clock"
    },
    {
      "content": {
        "kind": "date",
        "locale": "en-US"
      },
      "title": "日付",
      "id": "at365.watch.date"
    }
  ]
}
